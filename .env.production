# Public values read by the production build (npm run build / npm run deploy).
# Neither is secret. Fill them in after deploying the push worker (see worker/README.md).
# Left empty, HORA still alerts while a tab is open; it just can't alert with the tab closed.

# Worker URL printed by `npm run deploy` in worker/, e.g. https://hora-push.your-name.workers.dev
VITE_PUSH_API_URL=

# Public key printed by `npm run keys` in worker/
VITE_VAPID_PUBLIC_KEY=
